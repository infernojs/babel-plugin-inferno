{
  "name": "babel-plugin-inferno",
  "version": "10.0.0",
  "description": "Turn JSX into Inferno virtual DOM",
  "repository": "https://github.com/trueadm/babel-plugin-inferno",
  "license": "MIT",
  "main": "lib/index.js",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "inferno": "^10.0.0-alpha.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "rollup": "^4.64.0"
  },
  "scripts": {
    "build": "rollup -c",
    "coverage": "nyc ./node_modules/.bin/_mocha tests.js \"tests/*.test.js\"",
    "test": "node ./node_modules/mocha/bin/mocha tests.js \"tests/*.test.js\"",
    "test:bugs": "node ./node_modules/mocha/bin/mocha \"tests/known-bugs/*.test.js\"",
    "bench": "node bench/run.js",
    "bench:quick": "node bench/run.js --quick",
    "bench:profile": "node bench/run.js --profile",
    "bench:compare": "node bench/run.js --baseline HEAD",
    "debug": "node --inspect-brk ./node_modules/mocha/bin/mocha tests.js \"tests/*.test.js\"",
    "lint": "eslint lib bench",
    "lintfix": "eslint lib bench --fix"
  },
  "keywords": [
    "babel-plugin",
    "babel",
    "es2015",
    "es2016",
    "inferno",
    "jsx"
  ],
  "dependencies": {
    "@babel/plugin-syntax-jsx": "^8",
    "@babel/types": "^8"
  },
  "engines": {
    "node": ">=24"
  }
}
